# Copy to .env (gitignored). Read by the server at startup (server/chat.py).
# Without a key the chat panel shows "not configured"; everything else works.
ANTHROPIC_API_KEY=
# Optional overrides
# DRIVKRAFT_CHAT_MODEL=claude-opus-5
# DRIVKRAFT_CHAT_EFFORT=medium
# Live tax research (Phase 5). Without a key only the cached demo questions answer.
BIZORA_API_KEY=
# BIZORA_BASE_URL=https://api-bizora.ai
# Hosted demo: require this code for live research, and as the bearer token for /mcp
# DRIVKRAFT_INVITE_CODE=

# Hosted demo only (set in fly.toml / fly secrets, not needed locally):
# DRIVKRAFT_DEMO=1                    # per-visitor sandboxes, rate limits, spend cap, nightly reset
# DRIVKRAFT_MONTHLY_CAP_USD=20        # Anthropic spend cap per calendar month (visitors' own keys don't count)
# DRIVKRAFT_MAX_VISITORS=300          # new sandboxes per day
# DRIVKRAFT_POOL_SIZE=3               # sandboxes seeded ahead of time
# DRIVKRAFT_RESET_HOUR_UTC=8
# DRIVKRAFT_PUBLIC_HOSTS=drivkraft-tax.fly.dev   # Host headers /mcp accepts
